; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Evolving RPG"
config/description="A turn-based grid RPG that grows its own world. The sim folds a
content-addressed event chain; the stage is only ever a projection of that fold."
config/features=PackedStringArray("4.6")

[autoload]

; The chain, and the only writer to it. Every stage node reads through this.
Chronicle="*res://autoload/Chronicle.gd"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"

[xogot]

project/editorState=[{
"column": 0,
"current": true,
"line": 0,
"path": "res://sim/ai.gd",
"type": "file"
}]
project/shaderEditorState=[]
project/breakpoints={}
project/disabled_breakpoints={}
